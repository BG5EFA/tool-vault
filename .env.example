# 复制为 .env 后按需修改（不要提交 .env）

# 前台 data.js 的绝对路径
TV_DATA_FILE=/var/www/tool-vault/assets/js/data.js

# SQLite 数据库路径
TV_DB=/var/www/tool-vault-admin/admin.db

# 允许访问后台的 Host，逗号分隔
TV_ALLOWED_HOSTS=res.example.com,127.0.0.1:8787,127.0.0.1,localhost:8787,localhost

# 允许的跨域来源，逗号分隔
TV_ALLOWED_ORIGINS=https://res.example.com

# 仅本地 HTTP 调试时设为 0
TV_COOKIE_SECURE=1
